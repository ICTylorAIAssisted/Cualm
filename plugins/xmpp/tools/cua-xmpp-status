#!/usr/bin/env python3
"""Check the XMPP daemon status.

Examples:
    cua-xmpp-status              # is the daemon running?
    cua-xmpp-status --inbox      # how many messages are waiting?
"""

import json
import os

import typer

from xmpp_tools.config import (
    DAEMON_STATUS_MARKER,
    INBOX_DIR,
    PID_FILE,
    STATUS_FILE,
    ensure_dirs,
)

app = typer.Typer(add_completion=False)


def _pid_alive(pid: int) -> bool:
    """Check if a PID is running."""
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


@app.command()
def xmpp_status(
    inbox: bool = typer.Option(
        False,
        "--inbox",
        "-i",
        help="Include count of pending inbox messages",
    ),
) -> None:
    """Check XMPP daemon status.

    \b
    Outputs a structured status object the agent loop can parse.

    \b
    Examples:
      cua-xmpp-status
      cua-xmpp-status --inbox
    """
    ensure_dirs()

    result = {
        "daemon_running": False,
        "state": "unknown",
        "pid": None,
        "jid": None,
    }

    # Check PID file
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            result["pid"] = pid
            result["daemon_running"] = _pid_alive(pid)
        except (ValueError, OSError):
            pass

    # Check status file
    if STATUS_FILE.exists():
        try:
            status = json.loads(STATUS_FILE.read_text(encoding="utf-8"))
            result["state"] = status.get("state", "unknown")
            result["jid"] = status.get("jid")
            result["last_update"] = status.get("timestamp")
        except (json.JSONDecodeError, OSError):
            pass

    # If PID is dead, override state
    if not result["daemon_running"]:
        result["state"] = "stopped"

    # Inbox count
    if inbox:
        try:
            result["inbox_pending"] = len(list(INBOX_DIR.glob("*.json")))
        except OSError:
            result["inbox_pending"] = 0

    typer.echo(DAEMON_STATUS_MARKER)
    typer.echo(json.dumps(result))


if __name__ == "__main__":
    app()
