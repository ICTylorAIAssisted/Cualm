#!/usr/bin/env python3
"""Long-running XMPP daemon.

Maintains a persistent connection to the Prosody server.
- Incoming messages → written as JSON files in INBOX_DIR
- Files appearing in OUTBOX_DIR → sent as XMPP messages, then deleted

Start with:  cua-xmpp-daemon          (foreground)
              cua-xmpp-daemon --bg     (background / daemonise)
"""

import asyncio
import json
import logging
import os
import signal
import ssl
import time
from datetime import datetime, timezone
from pathlib import Path

import slixmpp
import typer

from xmpp_tools.config import (
    INBOX_DIR,
    OUTBOX_DIR,
    PID_FILE,
    STATUS_FILE,
    XMPP_HOST,
    XMPP_JID,
    XMPP_PASSWORD,
    XMPP_PEER_JID,
    XMPP_PORT,
    XMPP_VERIFY_CERT,
    atomic_write,
    ensure_dirs,
)

log = logging.getLogger("cua-xmpp-daemon")

app = typer.Typer(add_completion=False)


# ── XMPP Bot ────────────────────────────────────────────────


class AgentXMPP(slixmpp.ClientXMPP):
    """Minimal XMPP client that bridges messages ↔ filesystem."""

    MAX_RECONNECT_DELAY = 60  # seconds

    def __init__(self, jid: str, password: str, server_addr: tuple[str, int]):
        super().__init__(jid, password)

        self._server_addr = server_addr
        self._reconnect_delay = 1
        self._should_reconnect = True

        self.add_event_handler("session_start", self.on_start)
        self.add_event_handler("message", self.on_message)
        self.add_event_handler("disconnected", self.on_disconnect)
        self.add_event_handler("connection_failed", self.on_connection_failed)
        self.add_event_handler("auth_success", self.on_auth_success)
        self.add_event_handler("failed_auth", self.on_auth_fail)

        # Register common plugins
        self.register_plugin("xep_0030")  # Service Discovery
        self.register_plugin("xep_0199")  # Ping
        self.register_plugin("xep_0313")  # MAM (message archive)

        self._outbox_task: asyncio.Task | None = None

    async def on_start(self, _event):
        """Session is live — send presence and start the outbox watcher."""
        self._reconnect_delay = 1  # reset backoff on success
        self.send_presence(pshow="chat", pstatus="CUA agent online")
        await self.get_roster()
        self._write_status("connected")
        log.info("Connected as %s", self.boundjid.bare)

        # Start polling outbox (cancel old task if reconnecting)
        if self._outbox_task and not self._outbox_task.done():
            self._outbox_task.cancel()
        self._outbox_task = asyncio.ensure_future(self._poll_outbox())

    def on_auth_success(self, _event):
        log.info("Authentication successful")

    def on_auth_fail(self, _event):
        log.error("Authentication FAILED — check XMPP_JID and XMPP_PASSWORD")
        self._write_status("auth_failed")
        self._should_reconnect = False  # don't retry with bad creds

    def on_connection_failed(self, _event):
        log.warning("Connection failed to %s:%s", *self._server_addr)
        self._write_status("connection_failed")

    def on_disconnect(self, _event):
        self._write_status("disconnected")
        log.warning("Disconnected from server")

        if not self._should_reconnect:
            return

        delay = self._reconnect_delay
        self._reconnect_delay = min(delay * 2, self.MAX_RECONNECT_DELAY)
        log.info("Reconnecting in %ds ...", delay)
        asyncio.ensure_future(self._reconnect(delay))

    async def _reconnect(self, delay: float):
        """Wait then reconnect."""
        await asyncio.sleep(delay)
        self._write_status("reconnecting")
        self.connect(self._server_addr)

    # ── Incoming messages → inbox files ──────────────────────

    def on_message(self, msg):
        """Handle an incoming message stanza."""
        if msg["type"] not in ("chat", "normal"):
            return

        body = msg["body"]
        if not body:
            return

        sender = str(msg["from"].bare)
        ts = datetime.now(timezone.utc).isoformat()
        seq = f"{int(time.time() * 1000)}"

        envelope = {
            "from": sender,
            "body": body,
            "timestamp": ts,
        }

        outpath = INBOX_DIR / f"{seq}.json"
        atomic_write(outpath, json.dumps(envelope))
        log.info("Queued incoming message from %s → %s", sender, outpath.name)

    # ── Outbox watcher → send XMPP messages ─────────────────

    async def _poll_outbox(self, interval: float = 0.5):
        """Watch OUTBOX_DIR for .json files, send them, delete."""
        while True:
            try:
                for p in sorted(OUTBOX_DIR.glob("*.json")):
                    try:
                        data = json.loads(p.read_text(encoding="utf-8"))
                        to = data.get("to", XMPP_PEER_JID)
                        body = data.get("body", "")
                        mtype = data.get("type", "chat")

                        if body:
                            self.send_message(mto=to, mbody=body, mtype=mtype)
                            log.info("Sent message to %s: %s", to, body[:80])

                        p.unlink()
                    except Exception:
                        log.exception("Failed to process outbox file %s", p.name)
                        # Rename so we don't retry forever
                        p.rename(p.with_suffix(".err"))
            except Exception:
                log.exception("Outbox poll error")

            await asyncio.sleep(interval)

    # ── Helpers ──────────────────────────────────────────────

    @staticmethod
    def _write_status(state: str):
        atomic_write(
            STATUS_FILE,
            json.dumps(
                {
                    "state": state,
                    "pid": os.getpid(),
                    "jid": XMPP_JID,
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                }
            ),
        )


# ── CLI entry point ──────────────────────────────────────────


@app.command()
def main(
    bg: bool = typer.Option(False, "--bg", help="Fork to background"),
    debug: bool = typer.Option(False, "--debug", help="Enable XMPP debug logging"),
):
    """Start the XMPP daemon."""
    ensure_dirs()

    if bg:
        pid = os.fork()
        if pid > 0:
            # Parent: write PID and exit
            PID_FILE.write_text(str(pid))
            typer.echo(f"Daemon started (pid {pid})")
            raise SystemExit(0)
        # Child continues below
        os.setsid()

    # Logging
    level = logging.DEBUG if debug else logging.INFO
    logging.basicConfig(
        level=level,
        format="%(asctime)s %(name)s %(levelname)s %(message)s",
    )
    if debug:
        logging.getLogger("slixmpp").setLevel(logging.DEBUG)

    PID_FILE.write_text(str(os.getpid()))

    # Determine server address
    host = XMPP_HOST or XMPP_JID.split("@")[1]
    server_addr = (host, XMPP_PORT)

    xmpp = AgentXMPP(XMPP_JID, XMPP_PASSWORD, server_addr)

    # TLS settings
    if not XMPP_VERIFY_CERT:
        xmpp.ssl_version = ssl.PROTOCOL_TLS_CLIENT
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        xmpp.ssl_context = ctx

    xmpp.connect(server_addr)

    # Handle signals for clean shutdown
    def _shutdown(signum, frame):
        log.info("Shutting down (signal %s)", signum)
        xmpp.disconnect()
        PID_FILE.unlink(missing_ok=True)
        STATUS_FILE.unlink(missing_ok=True)
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, _shutdown)
    signal.signal(signal.SIGINT, _shutdown)

    xmpp.process(forever=True)


if __name__ == "__main__":
    app()
