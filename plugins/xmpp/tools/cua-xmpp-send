#!/usr/bin/env python3
"""Send a message to the phone user via XMPP.

Drops a JSON file in the daemon's outbox directory.
The daemon picks it up and sends it over the live XMPP connection.

Examples:
    cua-xmpp-send "Task complete — screenshot saved"
    cua-xmpp-send "Found 3 results" --result '{"urls": ["https://a.com"]}'
    cua-xmpp-send "Awaiting instructions" --to other@domain.com
"""

import json
import time
from typing import Optional

import typer

from xmpp_tools.config import (
    MSG_SENT_MARKER,
    OUTBOX_DIR,
    XMPP_PEER_JID,
    atomic_write,
    ensure_dirs,
)

app = typer.Typer(add_completion=False)


@app.command()
def xmpp_send(
    message: str = typer.Argument(..., help="Message body to send"),
    result: Optional[str] = typer.Option(
        None,
        "--result",
        "-r",
        help="Structured data to append (JSON string or plain value)",
    ),
    to: Optional[str] = typer.Option(
        None,
        "--to",
        "-t",
        help=f"Recipient JID (default: {XMPP_PEER_JID})",
    ),
) -> None:
    """Send a message to the phone user.

    \b
    The message is queued in the daemon's outbox and sent over the
    persistent XMPP connection.  Output includes a structured marker
    the agent loop can detect.

    \b
    Examples:
      cua-xmpp-send "Opened the browser and navigated to target page"
      cua-xmpp-send "Price extracted" --result "42.50"
      cua-xmpp-send '{"status": "done", "files": 3}' --to admin@server
    """
    ensure_dirs()

    # Build the body — optionally append structured result
    body = message
    if result is not None:
        body = f"{message}\n---\n{result}"

    envelope = {
        "to": to or XMPP_PEER_JID,
        "body": body,
        "type": "chat",
    }

    # Write to outbox (daemon picks it up within ~500ms)
    seq = f"{int(time.time() * 1000)}"
    outpath = OUTBOX_DIR / f"{seq}.json"
    atomic_write(outpath, json.dumps(envelope))

    # Emit marker for the agent loop
    payload = {
        "to": envelope["to"],
        "body": body,
        "queued": outpath.name,
    }
    typer.echo(MSG_SENT_MARKER)
    typer.echo(json.dumps(payload))


if __name__ == "__main__":
    app()
