# Copy to `.env` and edit. All keys are optional unless noted.

# ── LLM upstream (the OpenAI-compatible endpoint) ──────────────────────
# UPSTREAM_SCHEME is http for a local LLM, https for a remote one (Modal etc).
# UPSTREAM_HOST defaults to host.docker.internal (the docker host).
# UPSTREAM_PORT is the port your LLM listens on (use 443 for https).
# UPSTREAM_PATH is the path prefix the agent appends (default /v1).
#
# Local example (LM Studio / Ollama / llama.cpp):
#   UPSTREAM_SCHEME=http
#   UPSTREAM_HOST=host.docker.internal
#   UPSTREAM_PORT=11434
#
# Modal example (after `modal deploy modal_vllm.py`):
#   UPSTREAM_SCHEME=https
#   UPSTREAM_HOST=<workspace>--cua-coverage-llm-serve.modal.run
#   UPSTREAM_PORT=443
UPSTREAM_SCHEME=http
UPSTREAM_HOST=host.docker.internal
UPSTREAM_PORT=11434
UPSTREAM_PATH=/v1

# ── Agent ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=not-needed
CUA_MODEL=

# Optional sampling knobs forwarded to the LLM
CUA_TEMPERATURE=
CUA_TOP_P=
CUA_PRESENCE_PENALTY=
# CUA_LLM_EXTRA_PARAMS is JSON merged into the request body (vendor params).
# For Gemma 4, thinking mode is OFF by default — enable it explicitly:
#   CUA_LLM_EXTRA_PARAMS='{"top_k":64,"chat_template_kwargs":{"enable_thinking":true}}'
CUA_LLM_EXTRA_PARAMS=

# ── Coverage run ───────────────────────────────────────────────────────
# Default target is the bundled demo site (http://coverage-target/).
# Override TARGET_URL to point at any externally-reachable site.
TARGET_URL=http://coverage-target/
CUA_MAX_STEPS=50
COVERAGE_TIMEOUT=900
COVERAGE_TARGET_PCT=
COVERAGE_SNAPSHOT_INTERVAL=1
COVERAGE_CREDENTIALS=

# ── Output ─────────────────────────────────────────────────────────────
# OUTPUT_DIR is mounted as /app/audit inside the agent — screenshots,
# a11y dumps, LLM I/O land here.
OUTPUT_DIR=./out
VNC_PORT=5900
