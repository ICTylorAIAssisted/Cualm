# Copy to `.env` and edit. All keys are optional unless noted.

# ── LLM upstream (the host-side OpenAI-compatible endpoint) ────────────
# UPSTREAM_HOST defaults to host.docker.internal (the docker host).
# UPSTREAM_PORT is the port your LLM listens on locally.
# UPSTREAM_PATH is the path prefix the agent appends (default /v1).
UPSTREAM_HOST=host.docker.internal
UPSTREAM_PORT=11434
UPSTREAM_PATH=/v1

# ── Agent ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=not-needed
CUA_MODEL=

# Optional sampling knobs forwarded to the LLM
CUA_TEMPERATURE=
CUA_TOP_P=
CUA_PRESENCE_PENALTY=
CUA_LLM_EXTRA_PARAMS=

# ── Coverage run ───────────────────────────────────────────────────────
# Default target is the bundled demo site (http://coverage-target/).
# Override TARGET_URL to point at any externally-reachable site.
TARGET_URL=http://coverage-target/
CUA_MAX_STEPS=50
COVERAGE_TIMEOUT=900
COVERAGE_TARGET_PCT=
COVERAGE_SNAPSHOT_INTERVAL=1
COVERAGE_CREDENTIALS=

# ── Output ─────────────────────────────────────────────────────────────
# OUTPUT_DIR is mounted as /app/audit inside the agent — screenshots,
# a11y dumps, LLM I/O land here.
OUTPUT_DIR=./out
VNC_PORT=5900
