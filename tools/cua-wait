#!/usr/bin/env python3
"""Wait (sleep) for a specified duration."""

import time
from typing import Optional

import typer

from cua_config import load_config

app = typer.Typer(add_completion=False)


@app.command()
def cua_wait(
    ms: int = typer.Argument(None, help="Duration in milliseconds"),
    seconds: Optional[float] = typer.Option(
        None, "--seconds", "-s", help="Duration in seconds (overrides ms)"
    ),
) -> None:
    """Sleep for a given duration.

    Defaults to the value in config.ini [agent] wait_default_ms.
    """
    cfg = load_config()

    if seconds is not None:
        dur = seconds
    elif ms is not None:
        dur = ms / 1000.0
    else:
        dur = cfg.getint("agent", "wait_default_ms") / 1000.0

    time.sleep(dur)
    typer.echo(f"Waited {dur:.3f}s")


if __name__ == "__main__":
    app()
