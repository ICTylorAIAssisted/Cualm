#!/usr/bin/env python3
"""Manage a task execution plan.

Create a plan, mark steps complete, or replan. The plan is stored
in a file and automatically injected into each LLM prompt so it
persists across the conversation history window.

Use | to separate steps (stays on one line, no quoting issues):
  cua-plan "Login | Navigate to Reports | Read data | Report result"

Usage:
  cua-plan "Login | Navigate | Read | Report"     create plan
  cua-plan --complete 1                            mark step 1 done
  cua-plan --complete 2 --note "Found the page"   mark with note
  cua-plan --fail 3 --note "Approach failed"       mark step failed
  cua-plan --expand 3 "Scroll to table | Read top row | Note name"
  cua-plan --replan "[DONE] Login | Use DevTools | Report"
  cua-plan --show                                  display current plan
"""

import json
import os
import sys

import typer

app = typer.Typer(add_completion=False)

PLAN_FILE = "/tmp/cua_plan.json"


def _load_plan() -> dict:
    if os.path.exists(PLAN_FILE):
        with open(PLAN_FILE) as f:
            return json.load(f)
    return {"steps": [], "version": 0}


def _save_plan(plan: dict) -> None:
    with open(PLAN_FILE, "w") as f:
        json.dump(plan, f, indent=2)


def _parse_steps(text: str) -> list[dict]:
    """Parse a plan string into structured steps.

    Accepts multiple separator styles:
      "Login | Navigate | Report"          pipe-separated (preferred)
      "1. Login | 2. Navigate | 3. Report" numbered + pipe
      "Login\\nNavigate\\nReport"           literal \\n
      Actual newlines                       also work
    """
    import re

    # Convert literal \n to real newlines
    text = text.replace("\\n", "\n")
    # Split on pipe if no newlines present, otherwise use newlines
    if "\n" not in text.strip() and "|" in text:
        lines = [s.strip() for s in text.split("|")]
    else:
        lines = text.strip().splitlines()

    steps = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        # Strip leading number/bullet if present
        for prefix in ("- ", "* "):
            if line.startswith(prefix):
                line = line[len(prefix):]
                break
        # Strip "N. " or "N) " or "Na. " prefix
        m = re.match(r"^\d+[a-zA-Z]?[.)]\s*", line)
        if m:
            line = line[m.end():]
        # Check for status markers
        status = "pending"
        if line.upper().startswith("[DONE]"):
            status = "done"
            line = line[6:].strip()
        elif line.upper().startswith("[FAIL]"):
            status = "failed"
            line = line[6:].strip()
        elif line.upper().startswith("[SKIP]"):
            status = "skipped"
            line = line[6:].strip()
        if line:
            steps.append({"text": line, "status": status, "note": ""})
    return steps


def _format_plan(plan: dict) -> str:
    """Format the plan for display."""
    if not plan.get("steps"):
        return "No plan set."
    lines = [f"Plan (v{plan['version']}):"]
    for i, step in enumerate(plan["steps"], 1):
        status_icon = {
            "pending": "○",
            "done": "✓",
            "failed": "✗",
            "skipped": "–",
        }.get(step["status"], "?")
        line = f"  {status_icon} {i}. {step['text']}"
        if step.get("note"):
            line += f"  ({step['note']})"
        lines.append(line)
    # Progress summary
    total = len(plan["steps"])
    done = sum(1 for s in plan["steps"] if s["status"] == "done")
    pending = sum(1 for s in plan["steps"] if s["status"] == "pending")
    failed = sum(1 for s in plan["steps"] if s["status"] == "failed")
    lines.append(f"  Progress: {done}/{total} done, {pending} pending, {failed} failed")
    return "\n".join(lines)


@app.command()
def plan(
    text: str = typer.Argument(None, help="Plan text (steps separated by | or newlines)"),
    complete: str = typer.Option(None, "--complete", "-c", help="Mark step(s) done (e.g. 4 or 4,5)"),
    fail: str = typer.Option(None, "--fail", "-f", help="Mark step(s) failed (e.g. 3 or 3,4)"),
    skip: str = typer.Option(None, "--skip", help="Mark step(s) skipped"),
    expand: int = typer.Option(None, "--expand", "-e", help="Replace step N with sub-steps from text"),
    note: str = typer.Option("", "--note", "-n", help="Note for --complete/--fail"),
    replan: str = typer.Option(None, "--replan", "-r", help="Replace plan with new text"),
    show: bool = typer.Option(False, "--show", "-s", help="Show current plan"),
) -> None:
    """Create or update a task execution plan."""

    def _parse_step_nums(s: str) -> list[int]:
        """Parse '4' or '4,5' into list of ints."""
        nums = []
        for part in s.split(","):
            part = part.strip()
            if part.isdigit():
                nums.append(int(part))
        return nums

    p = _load_plan()

    if show:
        typer.echo(_format_plan(p))
        return

    if replan is not None:
        p["steps"] = _parse_steps(replan)
        p["version"] = p.get("version", 0) + 1
        _save_plan(p)
        typer.echo(f"Plan replaced (v{p['version']}):")
        typer.echo(_format_plan(p))
        return

    if expand is not None:
        idx = expand - 1
        if 0 <= idx < len(p.get("steps", [])):
            if not text:
                typer.echo("--expand requires plan text as argument", err=True)
                raise typer.Exit(1)
            sub_steps = _parse_steps(text)
            # Replace step N with the sub-steps
            original = p["steps"][idx]
            p["steps"] = p["steps"][:idx] + sub_steps + p["steps"][idx + 1:]
            p["version"] = p.get("version", 0) + 1
            _save_plan(p)
            typer.echo(f"Step {expand} ({original['text']}) expanded into {len(sub_steps)} sub-steps:")
            typer.echo(_format_plan(p))
        else:
            typer.echo(f"Invalid step number: {expand}", err=True)
            raise typer.Exit(1)
        return

    if complete is not None:
        nums = _parse_step_nums(complete)
        for n in nums:
            idx = n - 1
            if 0 <= idx < len(p.get("steps", [])):
                p["steps"][idx]["status"] = "done"
                if note:
                    p["steps"][idx]["note"] = note
            else:
                typer.echo(f"Invalid step number: {n}", err=True)
                raise typer.Exit(1)
        _save_plan(p)
        typer.echo(f"Step(s) {','.join(str(n) for n in nums)} marked done.")
        typer.echo(_format_plan(p))
        return

    if fail is not None:
        nums = _parse_step_nums(fail)
        for n in nums:
            idx = n - 1
            if 0 <= idx < len(p.get("steps", [])):
                p["steps"][idx]["status"] = "failed"
                if note:
                    p["steps"][idx]["note"] = note
            else:
                typer.echo(f"Invalid step number: {n}", err=True)
                raise typer.Exit(1)
        _save_plan(p)
        typer.echo(f"Step(s) {','.join(str(n) for n in nums)} marked failed.")
        typer.echo(_format_plan(p))
        return

    if skip is not None:
        nums = _parse_step_nums(skip)
        for n in nums:
            idx = n - 1
            if 0 <= idx < len(p.get("steps", [])):
                p["steps"][idx]["status"] = "skipped"
                if note:
                    p["steps"][idx]["note"] = note
            else:
                typer.echo(f"Invalid step number: {n}", err=True)
                raise typer.Exit(1)
        _save_plan(p)
        typer.echo(f"Step(s) {','.join(str(n) for n in nums)} skipped.")
        typer.echo(_format_plan(p))
        return

    if text:
        p["steps"] = _parse_steps(text)
        p["version"] = p.get("version", 0) + 1
        _save_plan(p)
        typer.echo(f"Plan created (v{p['version']}):")
        typer.echo(_format_plan(p))
        return

    # No args — show plan
    typer.echo(_format_plan(p))


if __name__ == "__main__":
    app()
