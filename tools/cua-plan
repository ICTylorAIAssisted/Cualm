#!/usr/bin/env python3
"""Manage a task execution plan.

Write the full plan each time, using markers for completed steps:
  cua-plan "Login | Navigate | Find data | Report"
  cua-plan "[DONE] Login | [DONE] Navigate | Set date range | Report"
  cua-plan "[DONE] Login | [DONE] Navigate | [DONE] Set date | Read table | Report"

Markers: [DONE], [FAIL], [SKIP]. Unmarked steps are pending.
Use | to separate steps. Rewrite the entire plan each time you
need to update progress or restructure.

Usage:
  cua-plan "Step 1 | Step 2 | Step 3"                     create/update plan
  cua-plan "[DONE] Step 1 | Step 2 | Step 3"              mark step 1 done
  cua-plan "[DONE] Step 1 | [FAIL] Step 2 | New approach"  mark + restructure
  cua-plan --show                                          display current plan
"""

import json
import os
import re

import typer

app = typer.Typer(add_completion=False)

PLAN_FILE = "/tmp/cua_plan.json"


def _load_plan() -> dict:
    try:
        with open(PLAN_FILE) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {"steps": [], "version": 0}


def _save_plan(plan: dict) -> None:
    with open(PLAN_FILE, "w") as f:
        json.dump(plan, f, indent=2)


def _parse_steps(text: str) -> list[dict]:
    """Parse a plan string into structured steps.

    Accepts pipe-separated or newline-separated steps.
    Status markers: [DONE], [FAIL], [SKIP] at start of step.
    """
    # Convert literal \n to real newlines
    text = text.replace("\\n", "\n")
    # Split on pipe if no newlines, otherwise use newlines
    if "\n" not in text.strip() and "|" in text:
        lines = [s.strip() for s in text.split("|")]
    else:
        lines = text.strip().splitlines()

    steps = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        # Map status icons copied from plan output (○ ✓ ✗ –)
        icon_status = None
        for icon, st in (("✓", "done"), ("✗", "failed"), ("–", "skipped"),
                         ("○", "pending")):
            if line.startswith(icon):
                icon_status = st
                line = line[len(icon):].strip()
                break
        # Strip leading number/bullet
        for prefix in ("- ", "* "):
            if line.startswith(prefix):
                line = line[len(prefix):]
                break
        m = re.match(r"^\d+[a-zA-Z]?[.)]\s*", line)
        if m:
            line = line[m.end():]

        # Check for text status markers (override icon if present)
        status = icon_status or "pending"
        for marker, st in (("[DONE]", "done"), ("[FAIL]", "failed"),
                           ("[SKIP]", "skipped")):
            if line.upper().startswith(marker):
                status = st
                line = line[len(marker):].strip()
                break

        # Strip number prefix again (handles "[DONE] 2. Navigate")
        m = re.match(r"^\d+[a-zA-Z]?[.)]\s*", line)
        if m:
            line = line[m.end():]

        if line:
            steps.append({"text": line, "status": status})
    return steps


def _format_plan(plan: dict) -> str:
    steps = plan.get("steps", [])
    if not steps:
        return "No plan set."
    version = plan.get("version", 0)
    total = len(steps)
    lines = [f"Plan (v{version}):"]
    for i, s in enumerate(steps, 1):
        icon = {"pending": "○", "done": "✓", "failed": "✗",
                "skipped": "–"}.get(s["status"], "?")
        lines.append(f"  {icon} {i}. {s['text']}")
    done = sum(1 for s in steps if s["status"] == "done")
    pending = sum(1 for s in steps if s["status"] == "pending")
    failed = sum(1 for s in steps if s["status"] == "failed")
    lines.append(f"  Progress: {done}/{total} done, {pending} pending, {failed} failed")
    return "\n".join(lines)


@app.command()
def plan(
    text: str = typer.Argument(None, help="Full plan with | separators and [DONE]/[FAIL] markers"),
    show: bool = typer.Option(False, "--show", "-s", help="Show current plan"),
) -> None:
    """Create or update the task plan.

    \b
    Write the full plan each time. Mark completed steps with [DONE]:
      cua-plan "Login | Navigate | Find data | Report"
      cua-plan "[DONE] Login | [DONE] Navigate | Set date | Report"

    Restructure by rewriting:
      cua-plan "[DONE] Login | [DONE] Navigate | Set date range | Choose period | Show Report | Read data | Report"
    """
    p = _load_plan()

    if show:
        typer.echo(_format_plan(p))
        return

    if not text:
        typer.echo(_format_plan(p))
        return

    p["steps"] = _parse_steps(text)
    p["version"] = p.get("version", 0) + 1
    _save_plan(p)
    typer.echo(_format_plan(p))


if __name__ == "__main__":
    app()
