#!/usr/bin/env python3
"""Drag from one coordinate to another.

Mouse-down at (X1, Y1), move to (X2, Y2), mouse-up.
Requires calibration (run `click` at screen center first).
"""

import subprocess
import time

import typer

from cua_config import get_display, load_config, map_coords, require_calibration

app = typer.Typer(add_completion=False)


@app.command()
def cua_drag(
    x1: int = typer.Argument(..., help="Start X (pixels, model space)"),
    y1: int = typer.Argument(..., help="Start Y (pixels, model space)"),
    x2: int = typer.Argument(..., help="End X (pixels, model space)"),
    y2: int = typer.Argument(..., help="End Y (pixels, model space)"),
) -> None:
    """Drag from (X1, Y1) to (X2, Y2)."""
    cfg = load_config()
    cal = require_calibration(cfg)
    env = get_display(cfg)

    sx1, sy1 = map_coords(cfg, cal, x1, y1)
    sx2, sy2 = map_coords(cfg, cal, x2, y2)

    def move(x: int, y: int) -> None:
        subprocess.run(["xdotool", "mousemove", str(x), str(y)],
                       check=True, env=env)

    try:
        # Chromium only starts an HTML5 drag (dragstart/dragover/drop) after
        # the pointer moves past a threshold in several real motion events,
        # and only fires drop if dragover has run on the target. A single
        # jump from A to B triggers dragstart at best, never drop. So: press,
        # nudge, glide in steps, hover on the target, then release.
        move(sx1, sy1)
        time.sleep(0.1)
        subprocess.run(["xdotool", "mousedown", "1"], check=True, env=env)
        time.sleep(0.15)
        for dx in (2, 5, 10):                 # cross the drag threshold
            move(sx1 + (dx if sx2 >= sx1 else -dx), sy1)
            time.sleep(0.05)
        steps = max(10, int(((sx2 - sx1) ** 2 + (sy2 - sy1) ** 2) ** 0.5 / 20))
        for i in range(1, steps + 1):
            move(round(sx1 + (sx2 - sx1) * i / steps),
                 round(sy1 + (sy2 - sy1) * i / steps))
            time.sleep(0.02)
        for jiggle in (1, -1, 0):             # dragover on the drop target
            move(sx2 + jiggle, sy2)
            time.sleep(0.1)
        subprocess.run(["xdotool", "mouseup", "1"], check=True, env=env)
    except FileNotFoundError:
        typer.echo("xdotool not found. Install with: apt install xdotool", err=True)
        raise typer.Exit(1)
    except subprocess.CalledProcessError as e:
        typer.echo(f"Drag failed: {e}", err=True)
        raise typer.Exit(1)

    typer.echo(
        f"Dragged model({x1},{y1})→({x2},{y2}) screen({sx1},{sy1})→({sx2},{sy2})"
    )


if __name__ == "__main__":
    app()
