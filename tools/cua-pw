@app.command()
def text(
    selector: str = typer.Argument(help="Element selector"),
    timeout: int = typer.Option(DEFAULT_TIMEOUT, help="Timeout in ms"),
) -> None:
    """Extract text content from an element."""
    page, pw = _get_page()
    try:
        loc = _resolve(page, selector)
        content = loc.inner_text(timeout=timeout)
        typer.echo(content)
    except PwTimeout:
        typer.echo(f"Error: Element not found within {timeout}ms: {selector}", err=True)
        raise typer.Exit(1)
    except Exception as e:
        typer.echo(f"Error: {e}", err=True)
        raise typer.Exit(1)
    finally:
        pw.stop()


@app.command()
def hover(
    selector: str = typer.Argument(help="Element selector"),
    timeout: int = typer.Option(DEFAULT_TIMEOUT, help="Timeout in ms"),
) -> None:
    """Hover over an element (useful for menus and tooltips)."""
    page, pw = _get_page()
    try:
        loc = _resolve(page, selector)
        loc.hover(timeout=timeout)
        typer.echo(f"Hovered: {selector}")
    except PwTimeout:
        typer.echo(f"Error: Element not found within {timeout}ms: {selector}", err=True)
        raise typer.Exit(1)
    except Exception as e:
        typer.echo(f"Error: {e}", err=True)
        raise typer.Exit(1)
    finally:
        pw.stop()


if __name__ == "__main__":
    app()
