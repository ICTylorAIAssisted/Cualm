#!/usr/bin/env python3
"""Press a key or key combination.

Common names are mapped automatically:
  enter/return → Return,  tab → Tab,  escape/esc → Escape,
  backspace → BackSpace,  space → space,  ctrl/alt/shift/super → modifiers

Combinations use '+' as separator: ctrl+a, ctrl+shift+t, alt+F4
"""

import re
import subprocess

import typer

from cua_config import get_display, load_config

app = typer.Typer(add_completion=False)

KEY_MAP = {
    "enter": "Return",
    "return": "Return",
    "tab": "Tab",
    "escape": "Escape",
    "esc": "Escape",
    "backspace": "BackSpace",
    "delete": "Delete",
    "space": "space",
    "up": "Up",
    "down": "Down",
    "left": "Left",
    "right": "Right",
    "home": "Home",
    "end": "End",
    "pageup": "Page_Up",
    "page_up": "Page_Up",
    "pagedown": "Page_Down",
    "page_down": "Page_Down",
    "f1": "F1",
    "f2": "F2",
    "f3": "F3",
    "f4": "F4",
    "f5": "F5",
    "f6": "F6",
    "f7": "F7",
    "f8": "F8",
    "f9": "F9",
    "f10": "F10",
    "f11": "F11",
    "f12": "F12",
    "ctrl": "ctrl",
    "control": "ctrl",
    "alt": "alt",
    "shift": "shift",
    "super": "super",
    "meta": "super",
    "cmd": "super",
}


def _normalize(raw: str) -> str:
    parts = re.split(r"[+\s]+", raw.strip())
    return "+".join(KEY_MAP.get(p.lower(), p) for p in parts if p)


@app.command()
def cua_key(
    keys: str = typer.Argument(
        None, help="Key combo, e.g. 'ctrl+c', 'Return', 'alt+F4'"
    ),
    list_keys: bool = typer.Option(
        False, "--list", "-l", help="Show all recognized key aliases"
    ),
) -> None:
    """Press a key or key combination."""
    if list_keys:
        typer.echo("Recognized key aliases (alias → xdotool name):")
        for alias, xname in sorted(KEY_MAP.items()):
            typer.echo(f"  {alias:12s} → {xname}")
        return

    if not keys:
        typer.echo(
            "No keys specified.\n"
            "Usage: key COMBO   (e.g. key ctrl+a, key Return)\n"
            "       key --list  (show all key aliases)",
            err=True,
        )
        raise typer.Exit(1)

    cfg = load_config()
    env = get_display(cfg)
    combo = _normalize(keys)

    try:
        subprocess.run(
            ["xdotool", "key", "--clearmodifiers", combo],
            check=True,
            env=env,
        )
    except FileNotFoundError:
        typer.echo("xdotool not found. Install with: apt install xdotool", err=True)
        raise typer.Exit(1)
    except subprocess.CalledProcessError as e:
        typer.echo(f"Key press failed: {e}", err=True)
        raise typer.Exit(1)

    typer.echo(f"Pressed {combo}")


if __name__ == "__main__":
    app()
