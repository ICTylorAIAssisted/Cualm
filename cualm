#!/usr/bin/env python3
"""cualm — sandboxed computer-use for coding agents.

Host-side helper that manages the cualm container (Xvfb + Chromium +
MCP server).  Works with podman or docker.

Usage:
  cualm build                       Build the container image
  cualm up [--port N] [--vnc N]     Start the sandbox + MCP server
  cualm down                        Stop and remove the sandbox
  cualm status                      Is it running? Is MCP answering?
  cualm logs                        Follow container logs
  cualm mcp-config                  Print MCP setup for Claude Code / OpenCode
  cualm run "task" [--json]         One-shot task with the built-in agent loop
                                    (fresh container, needs OPENAI_BASE_URL/CUA_MODEL)
"""

import argparse
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).parent.resolve()
IMAGE = os.environ.get("CUALM_IMAGE", "cualm")
NAME = os.environ.get("CUALM_CONTAINER", "cualm")
CAL_VOLUME = "cualm-calibration"


def load_env() -> None:
    """Load ROOT/.env (does not override existing variables)."""
    env_path = ROOT / ".env"
    if not env_path.exists():
        return
    for line in env_path.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, _, val = line.partition("=")
            os.environ.setdefault(key.strip(), val.strip().strip("'\""))


def runtime() -> str:
    rt = os.environ.get("CUALM_RUNTIME")
    if rt:
        return rt
    for cand in ("podman", "docker"):
        if shutil.which(cand):
            return cand
    sys.exit("error: neither podman nor docker found")


def llm_env() -> list[str]:
    """-e flags for the agent's LLM settings (only used by run_task/run)."""
    base = os.environ.get("OPENAI_BASE_URL", "http://host.docker.internal:8000/v1")
    # localhost on the host is not localhost in the container
    for local in ("://localhost", "://127.0.0.1"):
        base = base.replace(local, "://host.docker.internal")
    flags = ["-e", f"OPENAI_BASE_URL={base}",
             "-e", f"OPENAI_API_KEY={os.environ.get('OPENAI_API_KEY', 'not-needed')}",
             "-e", f"CUA_MODEL={os.environ.get('CUA_MODEL', 'your-model-name')}"]
    for var in ("CUA_TEMPERATURE", "CUA_TOP_P", "CUA_PRESENCE_PENALTY",
                "CUA_LLM_EXTRA_PARAMS", "CUA_HISTORY_PAIRS", "CUA_START_URL"):
        if os.environ.get(var):
            flags += ["-e", f"{var}={os.environ[var]}"]
    return flags


def common_flags() -> list[str]:
    return ["--add-host", "host.docker.internal:host-gateway",
            "--shm-size", "1g",
            "-v", f"{CAL_VOLUME}:/var/cua/calibration"]


def image_exists(rt: str) -> bool:
    return subprocess.run([rt, "image", "inspect", IMAGE],
                          capture_output=True).returncode == 0


def ensure_image(rt: str) -> None:
    if not image_exists(rt):
        print(f"Image '{IMAGE}' not found — building it first.", file=sys.stderr)
        cmd_build(None)


def mcp_url(port: int) -> str:
    return f"http://localhost:{port}/mcp"


def mcp_alive(port: int) -> bool:
    try:
        urllib.request.urlopen(mcp_url(port), timeout=2)
        return True
    except urllib.error.HTTPError:
        return True  # any HTTP answer means the server is up
    except Exception:
        return False


# ── Commands ──────────────────────────────────────────────


def cmd_build(args) -> None:
    rt = runtime()
    rc = subprocess.call([rt, "build", "-t", IMAGE, str(ROOT)])
    if rc:
        sys.exit(rc)


def cmd_up(args) -> None:
    rt = runtime()
    ensure_image(rt)
    subprocess.run([rt, "rm", "-f", NAME], capture_output=True)
    cmd = [rt, "run", "-d", "--name", NAME,
           "-p", f"127.0.0.1:{args.port}:8765",
           "-p", f"127.0.0.1:{args.vnc}:5900",
           *common_flags(), *llm_env(), IMAGE, "serve"]
    rc = subprocess.call(cmd, stdout=subprocess.DEVNULL)
    if rc:
        sys.exit(rc)
    deadline = time.time() + 60
    while time.time() < deadline:
        if mcp_alive(args.port):
            print(f"cualm is up\n  MCP: {mcp_url(args.port)}\n"
                  f"  VNC: localhost:{args.vnc}")
            return
        time.sleep(1)
    print(f"MCP server did not answer within 60s — see: {Path(sys.argv[0]).name} logs",
          file=sys.stderr)
    sys.exit(1)


def cmd_down(args) -> None:
    subprocess.call([runtime(), "rm", "-f", NAME], stdout=subprocess.DEVNULL)


def cmd_status(args) -> None:
    rt = runtime()
    p = subprocess.run([rt, "inspect", "-f", "{{.State.Status}}", NAME],
                       capture_output=True, text=True)
    state = p.stdout.strip() if p.returncode == 0 else "not created"
    print(f"container: {NAME} ({state})")
    print(f"image:     {IMAGE} ({'present' if image_exists(rt) else 'missing'})")
    alive = mcp_alive(args.port)
    print(f"mcp:       {mcp_url(args.port)} ({'up' if alive else 'down'})")
    sys.exit(0 if alive else 1)


def cmd_logs(args) -> None:
    os.execvp(runtime(), [runtime(), "logs", "-f", NAME])


def cmd_mcp_config(args) -> None:
    url = mcp_url(args.port)
    print(f"""# Claude Code
claude mcp add --transport http cualm {url}

# OpenCode — add to opencode.json
{{
  "mcp": {{
    "cualm": {{ "type": "remote", "url": "{url}", "enabled": true }}
  }}
}}

# Skill (optional, recommended): copy skills/cualm into
#   ~/.claude/skills/   (Claude Code)
#   ~/.config/opencode/skills/  (OpenCode)""")


def cmd_run(args) -> None:
    rt = runtime()
    ensure_image(rt)
    cmd = [rt, "run", "--rm", *common_flags(), *llm_env()]
    if args.vnc:
        cmd += ["-p", f"127.0.0.1:{args.vnc}:5900"]
    cmd += [IMAGE, "agent", "--max-steps", str(args.max_steps)]
    if args.start_url:
        cmd += ["--start-url", args.start_url]
    if args.json:
        cmd.append("--json")
    cmd += ["--", " ".join(args.task)]
    sys.exit(subprocess.call(cmd))


def main() -> None:
    load_env()
    default_port = int(os.environ.get("CUA_MCP_PORT", "8765"))
    default_vnc = int(os.environ.get("CUA_VNC_PORT", "5900"))

    parser = argparse.ArgumentParser(
        prog="cualm", description="Sandboxed computer-use for coding agents.",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("build", help="Build the container image").set_defaults(func=cmd_build)

    p = sub.add_parser("up", help="Start sandbox + MCP server")
    p.add_argument("--port", type=int, default=default_port, help="MCP host port")
    p.add_argument("--vnc", type=int, default=default_vnc, help="VNC host port")
    p.set_defaults(func=cmd_up)

    sub.add_parser("down", help="Stop the sandbox").set_defaults(func=cmd_down)

    p = sub.add_parser("status", help="Show sandbox status")
    p.add_argument("--port", type=int, default=default_port)
    p.set_defaults(func=cmd_status)

    sub.add_parser("logs", help="Follow container logs").set_defaults(func=cmd_logs)

    p = sub.add_parser("mcp-config", help="Print MCP client setup")
    p.add_argument("--port", type=int, default=default_port)
    p.set_defaults(func=cmd_mcp_config)

    p = sub.add_parser("run", help="One-shot task with the built-in agent loop")
    p.add_argument("task", nargs="+")
    p.add_argument("--start-url")
    p.add_argument("--max-steps", type=int, default=30)
    p.add_argument("--json", action="store_true",
                   help="Logs to stderr, JSON result on stdout")
    p.add_argument("--vnc", type=int, help="Expose VNC on this host port")
    p.set_defaults(func=cmd_run)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
